supervisor=supervise-daemon

respawn_delay="5"
respawn_max="10"
respawn_period="60"

name=weed-admin
command="/usr/bin/weed"
command_args="${WEED_EXEC} ${WEED_OPTS}"

pidfile="/var/run/${RC_SVCNAME}.pid"

depend() {
	need net
}
